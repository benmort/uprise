# pnpm 11 verifies node_modules before every `pnpm run`/`pnpm exec` and spawns
# `pnpm install` to "fix" a mismatch. In the worker's Railway container that
# install ran as --production (NODE_ENV in the image), demanded a TTY to purge
# the dev-dep modules dir, and aborted every deploy at preDeploy (prisma
# migrate). The image is immutable at run time – never reinstall on run.
verify-deps-before-run=false
