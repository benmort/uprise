{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter worker build && pnpm --filter worker deploy --legacy --prod worker-deploy",
    "watchPatterns": [
      "apps/worker/**",
      "packages/db/**",
      "packages/events/**",
      "packages/contracts/**",
      "pnpm-lock.yaml",
      "package.json",
      "railway.json"
    ]
  },
  "deploy": {
    "preDeployCommand": "pnpm --filter @uprise/db exec prisma migrate deploy",
    "startCommand": "node worker-deploy/dist/worker/src/main.js",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
